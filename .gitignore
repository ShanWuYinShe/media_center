# =========================================================
# Media Center Android App 根目录 .gitignore
# =========================================================

# ----- Gradle / Android -----
**/.gradle/
**/build/
**/local.properties
**/captures/
**/.cxx/
**/*.apk
**/*.aab
**/*.iml
# Android Studio updateDaemonJvm 自动生成,不入库
**/gradle/gradle-daemon-jvm.properties

# ----- IDE / 编辑器 -----
# Android Studio / IntelliJ:只忽略机器特定 / 频繁变动的文件,
# 保留可共享的项目级配置(inspection profiles 等),让团队设置(如关闭拼写检查)
# 能进版本库。.idea/ 自带的 .gitignore 会补充忽略 shelf/workspace.xml。
**/.idea/workspace.xml
**/.idea/caches/
**/.idea/shelf/
**/.idea/.name
**/.idea/deploymentTargetSelector.xml
**/.idea/runConfigurations.xml
**/.vscode/
**/.fleet/
**/*.swp
**/*.swo
*~

# ----- 操作系统 -----
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ----- 日志与临时文件 -----
**/*.log
**/tmp/
**/.tmp/
**/.cache/
.env
.env.local
.env.*.local

# ----- media_server 运行时生成的分类快照(非提交;线上由后台定期刷新生成) -----
media_server/data/
**/snapshots/*.json

# ----- media_server 分类维护数据库(SQLite system-of-record;含 WAL/SHM 旁文件) -----
**/*.db
**/*.db-wal
**/*.db-shm
**/*.sqlite
**/*.sqlite3

# ----- media_server 编译产物(go build 在包目录生成的同名二进制) -----
media_server/media_server

# ----- AI Agent 工作目录 -----
.workwork/

# ----- AI Worktree -----
.worktrees/

# ----- AI 会话临时工作文件 -----
.superpowers/
.zcode/
