# media 站（media.chaoset.com）基础镜像版本唯一事实来源。
# 升级：改这里 → make build → make up 重建；改完顺手核对
# media_server/Dockerfile 与 .github/workflows/ci.yml 的同名字段仍一致
# （PYTHON_VERSION ↔ ci.yml setup-python；YT_DLP_VERSION 经 compose build args
# 注入 vod_extractor/Dockerfile，yt-dlp 是 YouTube 风控对抗最关键的版本）。
GO_VERSION=1.26.8
ALPINE_VERSION=3.24.1
PYTHON_VERSION=3.14.7
NGINX_VERSION=1.30.4
YT_DLP_VERSION=2026.07.04
