# media 站边缘网关（media.chaoset.com）。
# ${MEDIA_DOMAIN} 由官方镜像 entrypoint envsubst 注入；nginx 运行时变量
# （$remote_addr 等）不在环境变量列表中，不会被替换。

server {
    listen 127.0.0.1:8080;
    server_name localhost;
    access_log off;

    location = /nginx-health {
        return 204;
    }
}

server {
    # 仅 IPv6 监听：公网入口链路是 Cloudflare → 本机 IPv6（ipvlan L3 直连），
    # 与 workwork nginx 同模型。IPv4 无入站路由，不是缺陷。
    listen [::]:443 ssl;
    http2 on;
    server_name ${MEDIA_DOMAIN};

    # 不对外暴露 nginx 版本号(纯 API 站,低成本加固)
    server_tokens off;

    ssl_certificate /etc/nginx/certs/server_cert.pem;
    ssl_certificate_key /etc/nginx/certs/server_cert.key;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;
    ssl_session_timeout 4h;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Cloudflare Authenticated Origin Pulls (mTLS)：
    # 前提是 chaoset.com zone 已开启 Authenticated Origin Pulls（见 deploy/README.md）。
    ssl_client_certificate /etc/nginx/cloudflare-origin-pull.pem;
    ssl_verify_client on;

    # real_ip：按 CF-Connecting-IP 还原真实客户端地址（include 由启动脚本生成），
    # media_server 的 per-IP 限流与日志依赖 X-Real-IP 取到真实客户端。
    include /etc/nginx/cloudflare-ips.conf;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;

    # 变量形式 upstream 在运行期解析,必须显式指定 resolver(127.0.0.11 =
    # docker 内嵌 DNS,可解析服务名并转发外部域名)。
    resolver 127.0.0.11 valid=30s;

    set $media_upstream media_server:8787;

    # APK 流式下载：不在 nginx 侧缓冲整包（300MB 级），超时放宽到与服务端
    # 下载路径（绕过其 60s API 超时包裹）匹配的量级。规范前缀与过渡期旧前缀同配。
    location ~ ^/api(?:/v1)?/app/download$ {
        proxy_pass http://$media_upstream;
        proxy_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # 内部管理接口不对公网暴露（与 workwork nginx 同约定）：catalog 审校/导入
    # 经宿主机直连容器或 ssh 隧道调用。
    location /internal/ {
        return 404;
    }

    # 业务 API：/api/v1/* 为规范前缀，/api/* 为过渡期旧别名（media_server
    # 内部归一化，行为一致；客户端全量切换后随别名一并移除本文件的 /api 分支）。
    # 不做路径改写，原样透传；media_server 限流键取 X-Real-IP（真实客户端）。
    location / {
        proxy_pass http://$media_upstream;
        client_max_body_size 4m;
    }
}
