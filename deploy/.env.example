# media 站运行时配置（复制为 .env 后按需修改；compose 与 Makefile 读取）。

# ── 站点寻址 ──────────────────────────────────────────────
# 对外域名（nginx server_name，须与 DNS AAAA 记录一致）
MEDIA_DOMAIN=media.chaoset.com
# 站点公网 IPv6（宿主 ipvlan_docker 网络内分配，独立于 workwork 的 NGINX_IPV6；
# 由服务器部署时按 ip -6 route 可用前缀分配，必填）
MEDIA_IPV6=

# ── App 接口令牌 ─────────────────────────────────────────
# App 端凭证接口令牌（/api/v1/providers/credentials 要求 X-App-Token；
# 与 App 构建期注入的 APP_API_TOKEN 一致，留空则凭证端点一律 401）
MEDIA_SERVER_APP_API_TOKEN=
# 站内运维令牌（/internal/* catalog 管理接口；留空整组路由 404。
# catalog 审校/导入经宿主机 curl 或 docker exec 调用）
MEDIA_SERVER_INTERNAL_TOKEN=

# ── App 更新通道 ─────────────────────────────────────────
# 更新下载公网基址（manifest 的 apkUrl 由它派生；禁止从请求 Host 推导）
MEDIA_SERVER_PUBLIC_URL=https://media.chaoset.com/api/v1

# ── vod_extractor（YouTube 解析）─────────────────────────
# 单请求超时（毫秒）
VOD_EXTRACTOR_TIMEOUT_MS=30000
# yt-dlp 输出字节上限（20MiB）
VOD_EXTRACTOR_MAX_OUTPUT_BYTES=20971520
# 并发解析上限
VOD_EXTRACTOR_MAX_CONCURRENT=2
# yt-dlp extractor-args（如 youtube:player_client=tv；留空走默认）
VOD_EXTRACTOR_EXTRACTOR_ARGS=
# cookies 文件显式路径（默认自动用 /config/youtube-cookies.txt，存在即生效）
VOD_EXTRACTOR_COOKIES_FILE=
# /extract 目标 host 白名单（逗号分隔；留空用内置 youtube 域默认）
VOD_EXTRACTOR_ALLOWED_EXTRACT_HOSTS=
