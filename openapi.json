{
  "openapi": "3.1.0",
  "info": {
    "title": "Media Server API",
    "version": "1.0.0",
    "description": "Public VOD aggregation API consumed by the Android TV app."
  },
  "servers": [
    {
      "url": "https://yinghuoren.com/api/media",
      "description": "Default public API base URL"
    }
  ],
  "paths": {
    "/categories": {
      "get": {
        "summary": "List public categories",
        "operationId": "listCategories",
        "responses": {
          "200": {
            "description": "Category list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["items"],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Category" }
                    }
                  }
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/categories/{id}/videos": {
      "get": {
        "summary": "List playable videos in a category",
        "operationId": "listCategoryVideos",
        "parameters": [
          { "$ref": "#/components/parameters/CategoryId" },
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PageSize" }
        ],
        "responses": {
          "200": {
            "description": "Playable videos",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PagedVideos" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "502": { "$ref": "#/components/responses/ProviderError" }
        }
      }
    },
    "/search": {
      "get": {
        "summary": "Search playable VOD videos",
        "operationId": "searchVideos",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "minLength": 1, "maxLength": 120 },
            "description": "Search keyword"
          },
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PageSize" }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PagedVideos" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "502": { "$ref": "#/components/responses/ProviderError" }
        }
      }
    },
    "/videos/{id}": {
      "get": {
        "summary": "Get video details",
        "operationId": "getVideoDetails",
        "parameters": [{ "$ref": "#/components/parameters/VideoId" }],
        "responses": {
          "200": {
            "description": "Video details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VideoDetails" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/NoPlayableStream" },
          "502": { "$ref": "#/components/responses/ProviderError" }
        }
      }
    },
    "/videos/{id}/playback": {
      "get": {
        "summary": "Get playback options",
        "operationId": "getPlaybackOptions",
        "parameters": [{ "$ref": "#/components/parameters/VideoId" }],
        "responses": {
          "200": {
            "description": "Playback options",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["items"],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/PlaybackOption" }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/NoPlayableStream" },
          "502": { "$ref": "#/components/responses/ProviderError" }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Service health check",
        "operationId": "healthCheck",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["ok"],
                  "properties": {
                    "ok": { "type": "boolean", "const": true }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/asset": {
      "get": {
        "summary": "Proxy a media or thumbnail asset",
        "operationId": "proxyAsset",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "uri" },
            "description": "Original asset URL. Supplied inside signed API responses; apps should not construct it manually."
          },
          {
            "name": "sig",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
            "description": "Server-issued HMAC signature for the original asset URL."
          },
          {
            "name": "Range",
            "in": "header",
            "required": false,
            "schema": { "type": "string" },
            "description": "Optional HTTP byte range, typically sent by the media player."
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/AssetStream" },
          "206": { "$ref": "#/components/responses/AssetStream" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "502": { "$ref": "#/components/responses/ProviderError" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "CategoryId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "minLength": 1, "maxLength": 80 }
      },
      "VideoId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "minLength": 1 },
        "description": "Opaque video id returned by list/search endpoints. URL-encode before using it in a path."
      },
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 1, "default": 1 }
      },
      "PageSize": {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "schema": { "type": "integer", "minimum": 1, "maximum": 40, "default": 20 }
      }
    },
    "schemas": {
      "Category": {
        "type": "object",
        "required": ["id", "title", "description"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      },
      "VideoSummary": {
        "type": "object",
        "required": ["id", "videoKind", "title", "description", "creators", "playbackKind"],
        "properties": {
          "id": { "type": "string", "description": "Opaque server-generated video id" },
          "videoKind": { "type": "string", "enum": ["vod"] },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "year": { "type": "string" },
          "creators": { "type": "array", "items": { "type": "string" } },
          "thumbnailUrl": { "type": "string", "format": "uri" },
          "durationSeconds": { "type": "integer", "minimum": 0 },
          "playbackKind": { "type": "string", "enum": ["vod"] }
        },
        "additionalProperties": true
      },
      "VideoDetails": {
        "allOf": [
          { "$ref": "#/components/schemas/VideoSummary" },
          {
            "type": "object",
            "required": ["playbackOptions"],
            "properties": {
              "playbackOptions": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/PlaybackOption" }
              }
            }
          }
        ]
      },
      "PlaybackOption": {
        "type": "object",
        "required": ["id", "kind", "label", "url", "mimeType"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string", "enum": ["vod"] },
          "label": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "mimeType": { "type": "string", "enum": ["video/mp4", "video/webm"] }
        },
        "additionalProperties": true
      },
      "PagedVideos": {
        "type": "object",
        "required": ["query", "page", "pageSize", "total", "items"],
        "properties": {
          "query": { "type": "string" },
          "category": { "$ref": "#/components/schemas/Category" },
          "page": { "type": "integer", "minimum": 1 },
          "pageSize": { "type": "integer", "minimum": 1, "maximum": 40 },
          "total": { "type": "integer", "minimum": 0 },
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/VideoSummary" }
          }
        },
        "additionalProperties": true
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "BAD_REQUEST",
                  "NOT_FOUND",
                  "NO_PLAYABLE_STREAM",
                  "INTERNAL_ERROR",
                  "PROVIDER_TIMEOUT",
                  "PROVIDER_UNAVAILABLE"
                ]
              },
              "message": { "type": "string" },
              "issues": { "type": "array", "items": { "type": "object" } }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
          }
        }
      },
      "NoPlayableStream": {
        "description": "No playable VOD stream",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
          }
        }
      },
      "ProviderError": {
        "description": "Provider, extractor, or upstream media error",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
          }
        }
      },
      "InternalError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
          }
        }
      },
      "AssetStream": {
        "description": "Proxied asset stream",
        "headers": {
          "Content-Type": { "schema": { "type": "string" } },
          "Content-Length": { "schema": { "type": "string" } },
          "Content-Range": { "schema": { "type": "string" } },
          "Accept-Ranges": { "schema": { "type": "string" } },
          "X-Cache": { "schema": { "type": "string", "enum": ["HIT", "MISS", "BYPASS"] } }
        },
        "content": {
          "video/mp4": { "schema": { "type": "string", "format": "binary" } },
          "video/webm": { "schema": { "type": "string", "format": "binary" } },
          "image/*": { "schema": { "type": "string", "format": "binary" } },
          "application/octet-stream": { "schema": { "type": "string", "format": "binary" } }
        }
      }
    }
  }
}
